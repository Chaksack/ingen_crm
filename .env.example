# Example local development environment file
# WARNING: This file previously contained real secrets. They have been replaced with placeholders.
# Copy this file to .env (if not already) and set real values locally. Do NOT commit real secrets.

RESEND_API_KEY=replace-with-your-resend-api-key
# Optional: only needed once a custom domain is verified in Resend. Without it, mail falls
# back to the shared onboarding@resend.dev sender, which can only deliver to the Resend
# account owner's own verified address - real invites to other people will fail until this is set.
RESEND_FROM_EMAIL=Ingenicx <noreply@yourdomain.com>
DATABASE_URL=postgresql://app_role:apppassword@localhost:5432/ingencore?sslmode=disable
JWT_SECRET=replace-with-a-random-32-byte-secret
VAPID_PUBLIC_KEY=BF_yUyz4Pydqxu4uiVLBtE8ZF0cJM-IZx-Z45eTJm0p_oV7w349d_KBu_nPxLXw-xdpYwrMiPrmc5K09KMnXBLc
VAPID_PRIVATE_KEY=Rzw1fuTuKy7HGnMlvg2X09tHyVW4W2w6a6xW3_EVySU
